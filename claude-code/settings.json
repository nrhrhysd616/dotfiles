{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(npm view *)",
      "Bash(npx eslint *)",
      "Bash(npx jest *)",
      "Bash(npx tsc *)",
      "Bash(pnpm format *)",
      "Bash(pnpm jest *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm test *)",
      "Bash(pnpm typecheck *)",
      "Bash(rm -f /private/tmp/claude-501/*)",
      "Bash(rm -r /private/tmp/claude-501/*)",
      "Bash(rm -rf /private/tmp/claude-501/*)",
      "Bash(rm /private/tmp/claude-501/*)",
      "Bash(rmdir /private/tmp/claude-501/*)"
    ],
    "deny": [
      "Read(*.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Bash(sudo rm *)",
      "Bash(git push --force *)",
      "Read(./secrets/**)"
    ],
    "ask": [
      "Bash(gh pr create *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(brew install *)",
      "Bash(brew uninstall *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "language": "japanese",
  "effortLevel": "xhigh",
  "plansDirectory": "./.claude/plans",
  "tui": "fullscreen",
  "theme": "dark-daltonized",
  "preferredNotifChannel": "iterm2_with_bell",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
