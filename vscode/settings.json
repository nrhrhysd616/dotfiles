  },
  // タスク・デバッグ用（自動化）のプロファイル: Linux（既定値）
  "terminal.integrated.automationProfile.linux": null,
  // タスク・デバッグ用（自動化）のプロファイル: macOS（既定値）
  "terminal.integrated.automationProfile.osx": null,
  // AIエージェント用ターミナルのプロファイル: Linux（既定値）
  "terminal.integrated.agentHostProfile.linux": null,
  // AIエージェント用ターミナルのプロファイル: macOS（既定値）
  "terminal.integrated.agentHostProfile.osx": null,
  // AIエージェント用ターミナルのプロファイル: Windows（既定値）
  "terminal.integrated.agentHostProfile.windows": null,

  // --- 統合ターミナル: シェル統合 ---

  // シェル統合を自動注入する（既定値）コマンド追跡・cwd検出などが有効になる
  "terminal.integrated.shellIntegration.enabled": true,
  // コマンドごとに装飾を表示（既定値）
  "terminal.integrated.shellIntegration.decorationsEnabled": "both",
  // シェルの環境情報を報告する（既定値）プロンプト表示が遅くなる場合がある
  "terminal.integrated.shellIntegration.environmentReporting": false,
  // ターミナルのコマンド履歴の保持件数（既定値）0で履歴無効
  "terminal.integrated.shellIntegration.history": 100,
  // コマンドのクイックフィックスを有効化（既定値）
  "terminal.integrated.shellIntegration.quickFixEnabled": true,
  // コマンドのホバー時にガイドを表示（既定値）
  "terminal.integrated.shellIntegration.showCommandGuide": true,
  // シェル統合の待ち時間（既定値・ミリ秒）-1は自動判定
  "terminal.integrated.shellIntegration.timeout": -1,
  // 実行中のコマンドを上部に固定表示（既定値）シェル統合の有効化が必要
  "terminal.integrated.stickyScroll.enabled": true,
  // 固定表示の対象外にするコマンド（既定値）
  "terminal.integrated.stickyScroll.ignoredCommands": [
    "clear",
    "cls",
    "clear-host",
    "agent",
    "agy",
    "copilot",
    "claude",
    "codex",
    "gemini"
  ],
  // 固定表示する最大行数（既定値）
  "terminal.integrated.stickyScroll.maxLineCount": 5,

  // --- 統合ターミナル: 入力補完 ---

  // ターミナルの入力補完（IntelliSense）を有効化（既定値）シェル統合の有効化が必要
  "terminal.integrated.suggest.enabled": true,
  // $CDPATH のサポート（既定値）
  "terminal.integrated.suggest.cdPath": "absolute",
  // シェルのインライン補完を検出して候補に反映する（既定値）
  "terminal.integrated.suggest.inlineSuggestion": "alwaysOnTop",
  // 候補確定後に空白を自動挿入する（既定値）
  "terminal.integrated.suggest.insertTrailingSpace": false,
  // 補完候補の提供元（既定値）
  "terminal.integrated.suggest.providers": {
    "lsp": false,
    "vscode.terminal-suggest": true
  },
  // 入力中に候補を自動表示する範囲（既定値）
  "terminal.integrated.suggest.quickSuggestions": {
    "commands": "off",
    "arguments": "off",
    "unknown": "off"
  },
  // Enterで候補を確定した際に即実行する（既定値）
  "terminal.integrated.suggest.runOnEnter": "never",
  // 候補の選択方式（既定値）
  "terminal.integrated.suggest.selectionMode": "partial",
  // 候補一覧にステータスバーを表示（既定値）
  "terminal.integrated.suggest.showStatusBar": true,
  // トリガー文字の入力で候補を自動表示（既定値）
  "terminal.integrated.suggest.suggestOnTriggerCharacters": false,
  // 上矢印キーでコマンド履歴を辿る（既定値）
  "terminal.integrated.suggest.upArrowNavigatesHistory": true,
  // 候補に含めるWindowsの実行ファイル拡張子（既定値）
  "terminal.integrated.suggest.windowsExecutableExtensions": {},

  // --- 統合ターミナル: タブ ---

  // ターミナルタブをリスト表示する（既定値）
  "terminal.integrated.tabs.enabled": true,
  // エージェントCLI（Claude Code等）にタブタイトルの変更を許可（既定値）
  "terminal.integrated.tabs.allowAgentCliTitle": true,
  // ターミナルアイコンの既定の色（既定値）
  "terminal.integrated.tabs.defaultColor": null,
  // ターミナルアイコンの既定のアイコン（既定値）
  "terminal.integrated.tabs.defaultIcon": "terminal",
  // タイトル右側に表示する説明の書式（既定値）
  "terminal.integrated.tabs.description": "${task}${separator}${local}${separator}${cwdFolder}",
  // タブのステータスにアニメーションを使う（既定値）
  "terminal.integrated.tabs.enableAnimation": true,
  // タブのターミナルにフォーカスする操作（既定値）
