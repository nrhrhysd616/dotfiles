  // コマンド終了検出のポーリング間隔（既定値・ミリ秒）
  "chat.tools.terminal.idlePollInterval": 1000,
  // 出力が途絶えてからバックグラウンドへ移すまでの時間（既定値・ミリ秒）
  "chat.tools.terminal.idleSilenceTimeoutMs": 300000,
  // 組み込みの自動承認ルールを無視する（既定値）
  "chat.tools.terminal.ignoreDefaultAutoApproveRules": false,
  // コマンド出力を圧縮してモデルへ返す（既定値）
  "chat.tools.terminal.outputCompaction": false,
  // 出力取得時に前回からの差分のみ返す（既定値）
  "chat.tools.terminal.outputDeltas": false,
  // ターミナルツールの出力表示先（既定値）
  "chat.tools.terminal.outputLocation": "chat",
  // ターミナルツールのコマンドをシェル履歴に残さない（既定値）
  "chat.tools.terminal.preventShellHistory": true,
  // ターミナルのツール呼び出しを折りたたみ表示にする（既定値）
  "chat.tools.terminal.simpleCollapsible": true,
  // ターミナルツールが使うプロファイル: Linux（既定値）
  "chat.tools.terminal.terminalProfile.linux": null,
  // ターミナルツールが使うプロファイル: macOS（既定値）
  "chat.tools.terminal.terminalProfile.osx": null,
  // ターミナルツールが使うプロファイル: Windows（既定値）
  "chat.tools.terminal.terminalProfile.windows": null,

  // --- インラインチャット ---

  // テキスト選択時にインラインチャットの導線を表示（既定値）
  "inlineChat.affordance": "off",
  // 編集セッション中のファイルでインラインチャットの代わりにAsk in Chatを使う（既定値）
  "inlineChat.askInChat": true,
  // インラインチャットの既定モデル（既定値）
  "inlineChat.defaultModel": "",
  // 診断に対する「修正」アクションを表示（既定値）
  "inlineChat.fixDiagnostics": true,
  // ノートブックのインラインチャットでエージェント的な挙動を有効化（既定値）
  "inlineChat.notebookAgent": false,

  // --- ディクテーション（音声入力）---

  // ディクテーションを有効化（既定値）
  "dictation.enabled": true,
  // ディクテーション終了時にLLMで句読点等を整える（実験的機能・既定値）
  "dictation.experimental.llmCleanup": true,
  // ディクテーションに使うモデル（既定値）
  "dictation.model": "nemotron-3.5-asr-streaming-0.6b",
  // ディクテーション中にトランスクリプトを表示（既定値）
  "dictation.showTranscript": true,

  // --- 画像プレビュー ---

  // チャットの画像添付をImages Previewで開く（既定値）
  "imageCarousel.chat.enabled": true,
  // エクスプローラーの右クリックに「Images Previewで開く」を表示（既定値）
  "imageCarousel.explorerContextMenu.enabled": true,

  // =============================================
  // Application > General - アプリケーション全般
  // =============================================

  // 描画が遅い場合に自動でプロファイリングする（実験的機能・既定値）
  "application.experimental.rendererProfiling": false,
  // シェル環境の解決を諦めるまでのタイムアウト（既定値・秒）
  "application.shellEnvironmentResolutionTimeout": 10,
  // 新しい問題報告ウィザードを使う（既定値）
  "issueReporter.wizard.enabled": false,
  // 問題報告時にワークスペース全体をスキャンする（既定値）
  "issueReporter.wizard.fullWorkspaceScan": true,
  // 現在の接続を従量制として扱う（既定値）従量制では自動更新等が延期される
  "network.meteredConnection": "auto",
  // オンボーディングツアーごとの開発者モード（既定値）
  "onboarding.developerMode": {},
  // オンボーディングツアー・ヒントを自動表示する（既定値）
  "onboarding.enabled": true,

  // =============================================
  // Application > Proxy - プロキシ
  // =============================================

  // Electronのfetch実装を使う（既定値）
  "http.electronFetch": false,
  // ネットワークインターフェース変更の確認間隔（実験的機能・既定値・秒）-1で無効
  "http.experimental.networkInterfaceCheckInterval": 300,
  // OSからのCA証明書読み込みの新方式（実験的機能・既定値）
  "http.experimental.systemCertificatesV2": false,
  // Node.jsのfetchにプロキシ・システム証明書のサポートを追加する（既定値）
  "http.fetchAdditionalSupport": true,
  // プロキシを経由しないドメイン（既定値）
  "http.noProxy": [],
  // 使用するプロキシ（既定値）空の場合は http_proxy / https_proxy 環境変数を継承
  "http.proxy": "",
  // Proxy-Authorizationヘッダーの値（既定値）
  "http.proxyAuthorization": null,
  // Kerberos認証のサービスプリンシパル名（既定値）
  "http.proxyKerberosServicePrincipal": "",
  // プロキシサーバーの証明書を検証する（既定値）
  "http.proxyStrictSSL": true,
  // 拡張機能へのプロキシサポート（既定値）
  "http.proxySupport": "override",
  // OSからCA証明書を読み込む（既定値）
  "http.systemCertificates": true,
  // Node.js組み込みのシステム証明書サポートを使う（既定値）
  "http.systemCertificatesNode": false,
  // リモート開発時にローカルのプロキシ設定を使う（既定値）
  "http.useLocalProxyConfiguration": true,
  // 組み込みWebSocketにプロキシ・システム証明書のサポートを追加する（既定値）
  "http.webSocketAdditionalSupport": true,

  // =============================================
  // Application > Keyboard - キーボード
  // =============================================

  // キー入力のディスパッチ方式（既定値）"code"が推奨
  "keyboard.dispatch": "code",
  // macOSのTouch Barボタンを有効化（既定値）
  "keyboard.touchbar.enabled": true,
  // Touch Barに表示しない項目（既定値）
  "keyboard.touchbar.ignored": [],

  // =============================================
  // Application > Update - 更新
  // =============================================

  // 自動更新の受け取り方（既定値）
  "update.mode": "default",
  // 更新後にリリースノートを開かずタイトルバーにヒントを出す（既定値）
  "update.showPostInstallInfo": false,
  // 更新後にリリースノートを表示（既定値）
  "update.showReleaseNotes": true,
  // タイトルバーに更新インジケーターを表示（既定値）
  "update.titleBar": true,

  // =============================================
  // Application > Telemetry - テレメトリ
  // =============================================
  // ※ 全体のテレメトリ送信は telemetry.telemetryLevel で制御する（現在は既定の "all"）。
  //    無効化したい場合は "off" を明示的に追加すること

  // 詳細な編集統計のテレメトリ（既定値）
  "telemetry.editStats.details.enabled": false,
  // 編集統計のテレメトリ（既定値）
  "telemetry.editStats.enabled": true,
  // 編集テレメトリの装飾を表示（既定値）
  "telemetry.editStats.showDecorations": false,
  // 編集テレメトリのステータスバーを表示（既定値）
  "telemetry.editStats.showStatusBar": false,
  // 問題報告・アンケートなどのフィードバック機能を有効化（既定値）
  "telemetry.feedback.enabled": true,
  // 入力遅延テレメトリの送信確率（既定値）0で無効
  "telemetry.performance.inputLatencySamplingProbability": 0,

  // =============================================
  // Application > Settings Sync - 設定の同期
  // =============================================
  // ※ このリポジトリでは設定をdotfilesとGitで管理しているため Settings Sync は使っていない

  // 同期対象から除外する拡張機能（既定値）
  "settingsSync.ignoredExtensions": [],
  // 同期対象から除外する設定（既定値）
  "settingsSync.ignoredSettings": [],
  // キーバインドをプラットフォームごとに同期する（既定値）
  "settingsSync.keybindingsPerPlatform": true,

  // =============================================
  // Security > Workspace - ワークスペースの信頼
  // =============================================

  // プロトコルハンドラ経由でローカルファイルを開く際に確認する（既定値）
  "security.promptForLocalFileProtocolHandling": true,
  // プロトコルハンドラ経由でリモートファイルを開く際に確認する（既定値）
  "security.promptForRemoteFileProtocolHandling": true,
  // 制限モードのバナーを表示するタイミング（既定値）
  "security.workspace.trust.banner": "untilDismissed",
  // 空のウィンドウを既定で信頼する（既定値）
  "security.workspace.trust.emptyWindow": true,
  // ワークスペースの信頼機能を有効化（既定値）セキュリティ機能のため無効化しない
  "security.workspace.trust.enabled": true,
  // 起動時に信頼を確認するプロンプトを出すタイミング（既定値）
  "security.workspace.trust.startupPrompt": "never",
  // 信頼済みワークスペースで未信頼ファイルを開く際の扱い（既定値）
  "security.workspace.trust.untrustedFiles": "prompt",

  // --- Claude Code ---

  // Claude Codeの表示位置（既定値）新しい場所で開くと自動更新される
  "claudeCode.preferredLocation": "panel",

  // --- Docker DX ---

  // Compose用の言語サーバーを有効化（デフォルト: true）
  // Red HatのYAML拡張機能と競合するため無効化。変更にはVSCodeの再起動が必要
  "docker.extension.enableComposeLanguageServer": false,

  // --- GitHub Authentication ---

  // 認証にデバイスコードフローを優先する（既定値）
  "github-authentication.preferDeviceCodeFlow": false,
  // HTTPリクエストにElectronのfetchを使う（既定値）反映には再起動が必要
  "github-authentication.useElectronFetch": true,

  // --- Git Graph ---

  // 「Date」列の日付表示形式（デフォルト: "Date & Time"）ISO形式にする
  "git-graph.date.format": "ISO Date & Time",

  // --- GitLens ---

  // AI機能に使うプロバイダー（既定値）VSCodeのモデルAPI（Copilot）を使う
  "gitlens.ai.model": "vscode",
  // VSCode提供モデルの指定（既定値）
  "gitlens.ai.vscode.model": "copilot:claude-sonnet-4.5",

  // --- Grunt / Gulp / Jake（同梱タスク検出）---

  // Gruntタスクの自動検出（既定値）ワークスペースのファイルが実行され得るため無効
  "grunt.autoDetect": "off",
  // Gulpタスクの自動検出（既定値）
  "gulp.autoDetect": "off",
  // Jakeタスクの自動検出（既定値）
  "jake.autoDetect": "off",

  // --- intelephense (PHP) ---

  // 波括弧のスタイル（デフォルト: "per"）K&Rスタイルにする
  "intelephense.format.braces": "k&r",

  // --- .ipynb（Jupyterノートブック）サポート ---

  // ノートブックのシリアライズをワーカースレッドで行う（実験的機能・既定値）
  "ipynb.experimental.serialization": true,
  // Markdownセルへの画像貼り付けを有効化（既定値）
  "ipynb.pasteImagesAsAttachments.enabled": true,

  // --- Java (Red Hat) ---

  // Java実行環境とローカルJDKの対応（デフォルト: []）
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-11",
      "path": "~/.sdkman/candidates/java/11.0.29-amzn"
    },
    {
      "name": "JavaSE-17",
      "path": "~/.sdkman/candidates/java/17.0.17-amzn"
    },
    {
      "name": "JavaSE-18",
      "path": "~/.sdkman/candidates/java/18.0.2-amzn",
      "default": true
    }
  ],
  // Eclipseフォーマッター設定XMLのURL（既定値: 未設定）このリポジトリのGoogle Styleベース設定を参照
  "java.format.settings.url": "https://raw.githubusercontent.com/nrhrhysd616/dotfiles/main/java/java-formatter-profile-nrhrhysd616-google-style.xml",
  // メタデータファイル（.project等）をプロジェクトルートに生成（デフォルト: false）
  "java.import.generatesMetadataFilesAtProjectRoot": true,
  // Gradleデーモンが使うJavaホーム（既定値: 未設定）
  "java.import.gradle.java.home": "~/.sdkman/candidates/java/17.0.17-amzn",
  // Java Language Serverが使うJavaホーム（既定値: 未設定）
  "java.jdt.ls.java.home": "~/.sdkman/candidates/java/18.0.2-amzn",
  // 参照のCodeLensを表示（デフォルト: false）
  "java.referencesCodeLens.enabled": true,

  // --- JS/TS Chat Features（同梱）---

  // JavaScript/TypeScript向けのCopilotスキル（既定値）
  "jsts-chat-features.skills.enabled": false,

  // --- Markdown（同梱プレビュー）---

  // 組み込みMarkdownプレビューで数式を描画（既定値）
  "markdown.math.enabled": true,
  // 数式のカスタムマクロ（既定値）
  "markdown.math.macros": {},

  // --- markdownlint ---

  // ルール設定（デフォルト: {}）
  // MD036=強調を見出し代わりに使う / MD040=コードブロックの言語指定 / MD060=テーブル記法 を無効化
  // ※ この設定自体は非推奨扱いで、本来は .markdownlint.json での指定が推奨されている
  "markdownlint.config": {
    "MD036": false,
    "MD040": false,
    "MD060": false
  },
  // リントを実行するタイミング（デフォルト: "onType"）入力中の警告が煩雑なため保存時に
  "markdownlint.run": "onSave",

  // --- Media Preview（同梱）---

  // 動画を自動再生する（既定値）
  "mediaPreview.video.autoPlay": false,
  // 動画をループ再生する（既定値）
  "mediaPreview.video.loop": false,

  // --- Microsoft 認証（同梱）---

  // Microsoftアカウントのサインイン実装（既定値）
  "microsoft-authentication.implementation": "msal",
  // ソブリンクラウドのカスタム構成（既定値）
  "microsoft-sovereign-cloud.customEnvironment": {},
  // 認証に使うソブリンクラウド（既定値）
  "microsoft-sovereign-cloud.environment": "",

  // --- Prettier ---

  // 行の最大幅（デフォルト: 80）editor.rulersの100と揃える
  "prettier.printWidth": 100,

  // --- Red Hat ---

  // 使用状況データをRed Hatへ送信する（既定値: true）送信しない
  "redhat.telemetry.enabled": false,

  // --- References（同梱）---

  // CodeLensの参照をクリックした際の表示方法（既定値）
  "references.preferredLocation": "peek",

  // --- Simple Browser（同梱）---

  // フォーカス中を示すフローティングインジケーターを表示（既定値）
  "simpleBrowser.focusLockIndicator.enabled": true,

  // --- Todo Tree ---

  // 検出するタグ（デフォルト: ["BUG","HACK","FIXME","TODO","XXX","[ ]","[x]"]）HACK/XXXを除いた構成
  "todo-tree.general.tags": ["BUG", "FIXME", "TODO", "[ ]", "[x]"],
  // 検出用の正規表現（デフォルト: "(//|#|<!--|;|/\\*|^|^[ \\t]*(-|\\d+.))\\s*($TAGS)"）
  // 行頭の空白を \s* にして、インデントされたリスト項目も拾えるようにしている
  "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^\\s*(-|\\d+.))\\s*($TAGS)",
  // ripgrepの実行パス（デフォルト: 未設定＝拡張機能同梱のバイナリを使用）
  // 同梱バイナリが解決できずツリーが空になる不具合の回避として明示的に指定する
  // 拡張機能が絶対パスを要求するため、Homebrewで導入したripgrepのパスを指定している
  "todo-tree.ripgrep.ripgrep": "/opt/homebrew/bin/rg",

  // --- YAML (Red Hat) ---

  // スキーマ自動判定を無効にするファイル（デフォルト: []）
  // GitHub Actions / Gitea / Forgejo のワークフローは誤ったスキーマが当たるため除外
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],

  // =============================================
  // 言語別設定
  // =============================================
  // 言語ごとに上書きする設定。ここでの指定はトップレベルの設定より優先される

  // Java: Red Hat拡張機能のフォーマッターを使う（java.format.settings.url の設定が効く）
  "[java]": {
    "editor.defaultFormatter": "redhat.java"
  },
  // JSON: 組み込みのJSON言語機能でフォーマットする（Prettierを使わない）
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  // Markdown: markdownlintでフォーマットし、空白の差分も検出する
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true
  },
  // PHP: intelephenseでフォーマットする
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
  },
  // Prisma: Prisma公式拡張機能でフォーマットする
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma"
  },
  // Terraform: HashiCorp公式拡張機能でフォーマットする
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform"
  },
  // XML: Red Hat拡張機能でフォーマットし、末尾の余分な改行を削除する
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml",
    "files.trimFinalNewlines": true
  }
}
