  // 検索時にシンボリックリンクを辿る（既定値）
  "search.followSymlinks": true,
  // 検索ビューでmacOSの共有検索クリップボードを使う（既定値）
  "search.globalFindClipboard": false,
  // 検索結果の最大件数（既定値）nullで無制限
  "search.maxResults": 20000,
  // 「ファイル内を検索」の実行先（既定値）検索ビューで開く
  "search.mode": "view",
  // クイック検索の入力内容を次回に復元（既定値）
  "search.quickAccess.preserveInput": false,
  // クイックオープンで絞り込んだ際の履歴の並び順（既定値）
  "search.quickOpen.history.filterSortOrder": "default",
  // クイックオープンに最近開いたファイルを含める（既定値）
  "search.quickOpen.includeHistory": true,
  // クイックオープンにシンボル検索結果を含める（既定値）
  "search.quickOpen.includeSymbols": false,
  // 検索（ripgrep）に使うスレッド数（既定値）0は自動決定
  "search.ripgrep.maxThreads": 0,
  // 検索エディタで前後に表示する行数（既定値）
  "search.searchEditor.defaultNumberOfContextLines": 1,
  // 検索エディタで結果をダブルクリックした時の動作（既定値）
  "search.searchEditor.doubleClickBehaviour": "goToLocation",
  // 検索実行時に入力欄ではなく結果にフォーカスする（既定値）
  "search.searchEditor.focusResultsOnSearch": false,
  // 新規検索エディタで前回の検索条件を引き継ぐ（既定値）
  "search.searchEditor.reusePriorSearchConfiguration": false,
  // 検索エディタで結果をシングルクリックした時の動作（既定値）
  "search.searchEditor.singleClickBehaviour": "default",
  // 入力しながら逐次検索する（既定値）
  "search.searchOnType": true,
  // 逐次検索を開始するまでの待ち時間（既定値）
  "search.searchOnTypeDebouncePeriod": 300,
  // 検索ビューでキーワード候補を提示（既定値）
  "search.searchView.keywordSuggestions": false,
  // 検索ビューのセマンティック検索の動作（既定値）
  "search.searchView.semanticSearchBehavior": "manual",
  // 検索ビューにフォーカスした際に選択テキストを検索欄へ入れる（既定値）
  "search.seedOnFocus": false,
  // 選択がない場合にカーソル位置の単語を検索欄へ入れる（既定値）
  "search.seedWithNearestWord": false,
  // 検索結果に行番号を表示（既定値）
  "search.showLineNumbers": false,
  // すべて小文字なら大文字小文字を区別しない検索にする（既定値）
  "search.smartCase": false,
  // 検索結果の並び順（既定値）
  "search.sortOrder": "default",
  // グローバルgitignoreを検索除外に使う（既定値）useIgnoreFilesの有効化が必要
  "search.useGlobalIgnoreFiles": false,
  // .gitignore / .ignore を検索除外に使う（既定値）
  "search.useIgnoreFiles": true,
  // 親ディレクトリの .gitignore も検索除外に使う（既定値）
  "search.useParentIgnoreFiles": false,
  // 置換時にプレビューを開く（既定値）
  "search.useReplacePreview": true,

