  // =============================================
  // Features > Explorer - エクスプローラー
  // =============================================

  // エクスプローラーにドロップしたファイルを自動的に開く（既定値）
  "explorer.autoOpenDroppedFile": true,
  // 開いているファイルをエクスプローラー上で自動追跡・選択する（デフォルト: true）
  // ツリーが勝手にスクロールするのを防ぐため無効化
  "explorer.autoReveal": false,
  // 自動追跡（autoReveal）の対象外にするパス（既定値）
  "explorer.autoRevealExclude": {
    "**/node_modules": true,
    "**/bower_components": true
  },
  // 子が1つだけのフォルダをまとめて表示（既定値）Javaのパッケージ構造などで有用
  "explorer.compactFolders": true,
  // ファイル・フォルダの削除時に確認する（既定値）
  "explorer.confirmDelete": true,
  // ドラッグ＆ドロップでの移動時に確認する（既定値）
  "explorer.confirmDragAndDrop": true,
  // OS上のファイルを貼り付ける際に確認する（既定値）
  "explorer.confirmPasteNative": true,
  // 元に戻す操作の際に確認する（既定値）
  "explorer.confirmUndo": "default",
  // パスをコピーする際の区切り文字（既定値）
  "explorer.copyPathSeparator": "auto",
  // 相対パスをコピーする際の区切り文字（既定値）
  "explorer.copyRelativePathSeparator": "auto",
  // ファイル装飾（Git状態など）にバッジを使う（既定値）
  "explorer.decorations.badges": true,
  // ファイル装飾に色を使う（既定値）
  "explorer.decorations.colors": true,
  // エクスプローラー内でのドラッグ＆ドロップ移動を許可（既定値）
  "explorer.enableDragAndDrop": true,
  // ファイル操作の取り消し（undo）を有効化（既定値）
  "explorer.enableUndo": true,
  // .gitignore の対象をエクスプローラーから隠す（既定値）
  "explorer.excludeGitIgnore": false,
  // フォルダが1つだけのマルチルートワークスペースを初期展開する（既定値）
  "explorer.expandSingleFolderWorkspaces": true,
  // ファイルのネスト表示（関連ファイルを親の下にまとめる）（既定値）
  "explorer.fileNesting.enabled": false,
  // ネストを自動展開する（既定値）fileNesting.enabledが有効な時のみ作用
  "explorer.fileNesting.expand": true,
  // ネストの親子パターン（既定値）fileNesting.enabledが有効な時のみ作用
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock"
  },
  // 複製時の命名規則（既定値）
  "explorer.incrementalNaming": "simple",
  // 「開いているエディター」ペインの最小表示枠数（既定値）0は動的にリサイズ
  "explorer.openEditors.minVisible": 0,
  // 「開いているエディター」ペインの並び順（既定値）
  "explorer.openEditors.sortOrder": "editorOrder",
  // 「開いているエディター」ペインの初期最大表示数（既定値）
  "explorer.openEditors.visible": 9,
  // ファイル・フォルダの並び順（既定値）
  "explorer.sortOrder": "default",
  // 名前の辞書順ソートの方式（既定値）
  "explorer.sortOrderLexicographicOptions": "default",
  // 並び順を逆にする（既定値）
  "explorer.sortOrderReverse": false,

  // =============================================
  // Features > Search - 検索
  // =============================================

  // 検索ビューの行内アクションバーの位置（既定値）
