  // タイトルバーのアプリアイコンをダブルクリックしてウィンドウを閉じる（既定値）
  "window.doubleClickIconToClose": false,
  // コンテキストメニューの外観（既定値）OS標準を使う
  "window.menuStyle": "native",
  // macOSのネイティブフルスクリーンを使う（既定値）無効にすると新しいスペースを作らない
  "window.nativeFullScreen": true,
  // macOSのネイティブウィンドウタブを有効化（既定値）変更には再起動が必要
  "window.nativeTabs": false,
  // 2つ目以降のウィンドウを開く際のサイズ（既定値）
  "window.newWindowDimensions": "default",
