{
  // =============================================================================
  // VSCode ユーザー設定
  // =============================================================================
  // このファイルは VSCode / VSCode Insiders / Cursor の3つから同一ファイルとして
  // シンボリックリンクされて共有される（init-mac.zsh の 290 / 294 / 298 行目）。
  // 編集する時はリンク先ではなく、必ずこのリポジトリ内のファイルを編集すること。
  //
  // 【方針】
  //   VSCode 1.132.0 のコア設定を網羅的に明示する。既定値のままの項目もあえて書くことで、
  //   アップデートで既定値が変わっても挙動が勝手に変わらないようにしている。
  //
  // 【コメントの表記】
  //   （デフォルト: X）        既定値から変更している項目。X が VSCode 側の既定値
  //   （既定値）               既定値のまま明示している項目
  //   （実験的機能・既定値）   実験的・プレビュー設定。将来のバージョンで削除されることがある
  //
  // 【セクション構成】
  //   VSCode の設定UI（Cmd+,）のカテゴリ構造に合わせて並べている。
  //   設定UIから項目を追加するとファイル末尾に自動追記されるので、
  //   気づいたら該当セクションへ移動させること。
  //
  // 【メンテナンス】
  //   - JSONC（コメント付きJSON）のため jq や標準JSONパーサでは処理できない
  //   - 末尾カンマは付けないこと。VSCode でこのファイルを直接開くと警告になる
  //     （ユーザー設定として読み込まれる時は許容されるが、リポジトリ内では厳格に検証される）
  //   - Cursor のベースは VSCode 1.105、code-server は 1.112 のため、
  //     それらで開くと新しい設定が「未知の設定」として警告表示される（動作に影響はない）
  //   - VSCode のメジャー更新後は、削除された設定が警告として残っていないか棚卸しすること。
  //     「実験的機能」コメントで検索すると棚卸し対象を一覧できる
  //   - 拡張機能に依存しない設定は code-server/settings.json にも反映すること
  // =============================================================================

  // =============================================
  // Text Editor - テキストエディタ
  // =============================================

  // スクリーンリーダー向け最適化モード（デフォルト: "auto"）パフォーマンス向上のため無効化
  "editor.accessibilitySupport": "off",
  // スクリーンリーダーが一度に読み上げる行数（既定値）
  "editor.accessibilityPageSize": 500,
  // AI挿入文字比率のゲージ表示（既定値）
  "editor.aiStats.enabled": false,
  // 可変フォント（バリアブルフォント）の使用を許可（既定値）
  "editor.allowVariableFonts": true,
  // アクセシビリティモード時の可変フォント使用（既定値）
  "editor.allowVariableFontsInAccessibilityMode": false,
  // 行ごとに異なる行高を許可（既定値）
  "editor.allowVariableLineHeights": true,
  // 空白文字の前でのみ括弧を自動閉じ（デフォルト: "languageDefined"）
  "editor.autoClosingBrackets": "beforeWhitespace",
  // 空白文字の前でのみコメントを自動閉じ（デフォルト: "languageDefined"）
  "editor.autoClosingComments": "beforeWhitespace",
  // 削除時に対になる閉じ括弧・引用符も削除する（既定値）
  "editor.autoClosingDelete": "auto",
  // 閉じ括弧・引用符の上から入力した際に上書きする（既定値）
  "editor.autoClosingOvertype": "auto",
  // 空白文字の前でのみ引用符を自動閉じ（デフォルト: "languageDefined"）
  "editor.autoClosingQuotes": "beforeWhitespace",
  // 入力・貼り付け・行移動時のインデント自動調整（既定値）
  "editor.autoIndent": "full",
  // 貼り付けた内容を自動インデントする（既定値）
  "editor.autoIndentOnPaste": false,
  // 文字列リテラル内に貼り付けた場合の自動インデント（既定値）autoIndentOnPasteが有効な時のみ作用
  "editor.autoIndentOnPasteWithinString": true,
  // 選択範囲がある状態で引用符・括弧を入力した際に囲む（既定値）
  "editor.autoSurround": "languageDefined",
  // 括弧ペアの色分けを有効化（既定値）
  "editor.bracketPairColorization.enabled": true,
  // 括弧の種類（(), [], {}）ごとに独立した色プールを使用（デフォルト: false）
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  // 診断のない行でも近傍のクイックフィックスを表示（既定値）
  "editor.codeActionWidget.includeNearbyQuickFixes": true,
  // コードアクションメニューにグループ見出しを表示（既定値）
  "editor.codeActionWidget.showHeaders": true,
  // フォーカス変更時に codeActionsOnSave を実行（既定値）
  "editor.codeActions.triggerOnFocusChange": false,
  // 保存時に実行するコードアクション（既定値）※プロジェクト側の設定で指定する運用
  "editor.codeActionsOnSave": {},
  // CodeLens（関数上部の参照数など）を表示（既定値）
  "editor.codeLens": true,
  // CodeLensのフォントファミリー（デフォルト: ""=エディタのフォントを継承）明示指定
  "editor.codeLensFontFamily": "'Fira Code', Menlo, Monaco, 'Courier New', monospace",
  // CodeLensのフォントサイズ（既定値）0はeditor.fontSizeの90%
  "editor.codeLensFontSize": 0,
  // 色リテラルにカラーデコレーター（色見本）を表示（既定値）
  "editor.colorDecorators": true,
  // カラーピッカーをクリック時のみ開く（デフォルト: "clickAndHover"）ホバーで誤って開かないように
  "editor.colorDecoratorsActivatedOn": "click",
  // カラーデコレーターの最大表示数（デフォルト: 500）描画負荷を抑えるため制限
  "editor.colorDecoratorsLimit": 30,
  // マウス+キーでの選択を矩形選択にする（既定値）
  "editor.columnSelection": false,
  // 空行もコメントトグルの対象にする（デフォルト: true=空行を無視）
  "editor.comments.ignoreEmptyLines": false,
  // コメント記号の後に空白を挿入（既定値）
  "editor.comments.insertSpace": true,
  // コピー時にシンタックスハイライトを含めない（デフォルト: true）プレーンテキストとして貼り付けたいため
  "editor.copyWithSyntaxHighlighting": false,
  // 既定のドキュメントカラープロバイダーで色装飾を表示（既定値）
  "editor.defaultColorDecorators": "auto",
  // 既定の折りたたみ範囲プロバイダー（既定値）
  "editor.defaultFoldingRangeProvider": null,
  // 既定のフォーマッター（デフォルト: null）Prettierを全体の既定にする
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  // 定義ジャンプのマウス操作を常にPeekビューで開く（デフォルト: false）
  "editor.definitionLinkOpensInPeek": true,
  // インデントの自動検出（デフォルト: true）tabSize/insertSpacesを常に適用するため無効化
  "editor.detectIndentation": false,
  // 括弧・引用符の隣でダブルクリックした際に中身を選択（既定値）
  "editor.doubleClickSelectsBlock": true,
  // 選択テキストのドラッグ＆ドロップ移動（デフォルト: true）誤操作防止のため無効化
  "editor.dragAndDrop": false,
  // Shift+ドラッグでのエディタへのファイルドロップ（デフォルト: true）誤操作防止のため無効化
  "editor.dropIntoEditor.enabled": false,
  // ドロップ時に優先する編集種別の順序（既定値）
  "editor.dropIntoEditor.preferences": [],
  // ドロップ後に挿入方法の選択ウィジェットを表示（既定値）
  "editor.dropIntoEditor.showDropSelector": "afterDrop",
  // 入力処理にEditContext APIを使用（既定値）
  "editor.editContext": true,
  // 選択範囲がない時のコピーで行全体をコピー（デフォルト: true）意図しない行コピーを防ぐため無効化
  "editor.emptySelectionClipboard": false,
  // トークン化をWeb Workerで非同期実行（実験的機能・既定値）
  "editor.experimental.asyncTokenization": true,
  // 非同期トークン化のログ出力（実験的機能・既定値）デバッグ用
  "editor.experimental.asyncTokenizationLogging": false,
  // 非同期トークン化を旧実装と突き合わせて検証（実験的機能・既定値）デバッグ用
  "editor.experimental.asyncTokenizationVerification": false,
  // CSSのTree-sitterパース（実験的機能・既定値）
  "editor.experimental.preferTreeSitter.css": false,
  // INIのTree-sitterパース（実験的機能・既定値）
  "editor.experimental.preferTreeSitter.ini": false,
  // 正規表現のTree-sitterパース（実験的機能・既定値）
  "editor.experimental.preferTreeSitter.regex": false,
  // TypeScriptのTree-sitterパース（実験的機能・既定値）
  "editor.experimental.preferTreeSitter.typescript": false,
  // Tree-sitterパースの有効化とテレメトリ収集（実験的機能・既定値）
  "editor.experimental.treeSitterTelemetry": false,
  // GPUアクセラレーションによる描画（実験的機能・既定値）
  "editor.experimentalGpuAcceleration": "off",
  // 空白文字の新描画方式（実験的機能・既定値）
  "editor.experimentalWhitespaceRendering": "svg",
  // Alt+スクロール時の高速スクロール倍率（デフォルト: 5）速すぎるため抑制
  "editor.fastScrollSensitivity": 3,
  // コードの折りたたみを有効化（既定値）
  "editor.folding": true,
  // 折りたたまれた範囲をハイライト（既定値）
  "editor.foldingHighlight": true,
  // import文を既定で折りたたむ（既定値）
  "editor.foldingImportsByDefault": false,
  // 折りたたみ可能な最大リージョン数（デフォルト: 5000）描画負荷を抑えるため制限
  "editor.foldingMaximumRegions": 3000,
  // 折りたたみ範囲の計算方法（既定値）
  "editor.foldingStrategy": "auto",
  // 行番号左のグリフマージン（ブレークポイント表示領域）を表示（既定値）
  "editor.glyphMargin": true,
  // 「宣言へ移動」の結果が現在位置しかない場合の代替コマンド（既定値）参照一覧を開く
  "editor.gotoLocation.alternativeDeclarationCommand": "editor.action.goToReferences",
  // 「定義へ移動」の結果が現在位置しかない場合の代替コマンド（既定値）参照一覧を開く
  "editor.gotoLocation.alternativeDefinitionCommand": "editor.action.goToReferences",
  // 「実装へ移動」の結果が現在位置しかない場合の代替コマンド（デフォルト: ""）他と揃えて参照一覧を開く
  "editor.gotoLocation.alternativeImplementationCommand": "editor.action.goToReferences",
  // 「参照へ移動」の結果が現在位置しかない場合の代替コマンド（デフォルト: ""）他と揃えて参照一覧を開く
  "editor.gotoLocation.alternativeReferenceCommand": "editor.action.goToReferences",
  // 「型定義へ移動」の結果が現在位置しかない場合の代替コマンド（既定値）参照一覧を開く
  "editor.gotoLocation.alternativeTypeDefinitionCommand": "editor.action.goToReferences",
  // 宣言が複数ある場合の挙動（既定値）
  "editor.gotoLocation.multipleDeclarations": "peek",
  // 定義が複数ある場合の挙動（既定値）
  "editor.gotoLocation.multipleDefinitions": "peek",
  // 実装が複数ある場合の挙動（既定値）
  "editor.gotoLocation.multipleImplementations": "peek",
  // 参照が複数ある場合の挙動（既定値）
  "editor.gotoLocation.multipleReferences": "peek",
  // 型定義が複数ある場合の挙動（既定値）
  "editor.gotoLocation.multipleTypeDefinitions": "peek",
  // 括弧ペアのガイド線を表示（デフォルト: false）ネストの把握のため有効化
  "editor.guides.bracketPairs": true,
  // 括弧ペアの水平ガイド線（既定値）
  "editor.guides.bracketPairsHorizontal": "active",
  // アクティブな括弧ペアをハイライト（既定値）
  "editor.guides.highlightActiveBracketPair": true,
  // アクティブなインデントガイドをハイライト（既定値）
  "editor.guides.highlightActiveIndentation": true,
  // インデントガイドを表示（既定値）
  "editor.guides.indentation": true,
  // 概要ルーラー（右端のミニ地図帯）でカーソル位置を隠す（既定値）
  "editor.hideCursorInOverviewRuler": false,
  // ホバーを行の上側に優先表示（既定値）
  "editor.hover.above": true,
  // ホバー表示までの遅延（デフォルト: 300ms）意図しないホバーを減らすため延長
  "editor.hover.delay": 500,
  // ホバー表示を有効化（既定値）
  "editor.hover.enabled": "on",
  // ホバーが消えるまでの遅延（既定値）hover.stickyが有効な時のみ作用
  "editor.hover.hidingDelay": 300,
  // 長い行の警告ホバー（トークン化スキップ時など）を表示（既定値）
  "editor.hover.showLongLineWarning": true,
  // ホバーにマウスを乗せている間は表示を維持（既定値）
  "editor.hover.sticky": true,
  // インデント幅（既定値）"tabSize"はeditor.tabSizeの値を使う
  "editor.indentSize": "tabSize",
  // 慣性スクロール（既定値）主にLinuxのタッチパッド向け
  "editor.inertialScroll": false,
  // インレイヒント（型注釈などの補助表示）を有効化（既定値）
  "editor.inlayHints.enabled": "on",
  // インレイヒントのフォントファミリー（デフォルト: ""=エディタのフォントを継承）明示指定
  "editor.inlayHints.fontFamily": "'Fira Code', Menlo, Monaco, 'Courier New', monospace",
  // インレイヒントのフォントサイズ（既定値）0はeditor.fontSizeを使う
  "editor.inlayHints.fontSize": 0,
  // インレイヒント1行あたりの最大長（既定値）0で無制限
  "editor.inlayHints.maximumLength": 43,
  // インレイヒントの前後に余白を入れる（既定値）
  "editor.inlayHints.padding": false,
  // Tabキーでスペースを挿入（既定値）detectIndentationを無効にしているため常に適用される
  "editor.insertSpaces": true,
  // インデント増減を判定する括弧記号の定義（既定値）言語別に指定する用途
  "editor.language.brackets": null,
  // 色分け対象の括弧ペアの定義（既定値）言語別に指定する用途
  "editor.language.colorizedBracketPairs": null,
  // 巨大ファイルで重い機能を自動的に無効化（既定値）
  "editor.largeFileOptimizations": true,
  // コードアクションの電球アイコンを表示（既定値）
  "editor.lightbulb.enabled": "onCode",
  // 行番号の表示（既定値）
  "editor.lineNumbers": "on",
  // リンク編集（HTMLの開始/終了タグを連動編集）（デフォルト: false）
  "editor.linkedEditing": true,
  // URLなどを検出してクリック可能にする（既定値）
  "editor.links": true,
  // 対応する括弧をハイライト（既定値）
  "editor.matchBrackets": "always",
  // トークン化する最大行長（デフォルト: 20000）長大な1行での描画停止を避けるため抑制
  "editor.maxTokenizationLineLength": 15000,
  // 中クリック時の動作（既定値）
  "editor.mouseMiddleClickAction": "default",
  // マウスホイールのスクロール量倍率（既定値）
  "editor.mouseWheelScrollSensitivity": 1,
  // Cmd+ホイールでフォントサイズを変更（既定値）
  "editor.mouseWheelZoom": false,
  // マルチカーソルの最大数（デフォルト: 10000）暴発時の負荷を抑えるため制限
  "editor.multiCursorLimit": 3000,
  // 重なったマルチカーソルを統合（既定値）
  "editor.multiCursorMergeOverlapping": true,
  // マルチカーソル追加時の修飾キー（既定値）
  "editor.multiCursorModifier": "alt",
  // 貼り付ける行数とカーソル数が一致する場合の貼り付け方（既定値）
  "editor.multiCursorPaste": "spread",
  // 同一シンボルの出現箇所をハイライトする範囲（既定値）
  "editor.occurrencesHighlight": "singleFile",
  // 出現箇所ハイライトの表示遅延（デフォルト: 0ms）カーソル移動中のちらつきを防ぐため
  "editor.occurrencesHighlightDelay": 200,
  // 上書き入力モード時のカーソル形状（既定値）
  "editor.overtypeCursorStyle": "block",
  // 上書き入力モードで貼り付けた場合に上書きする（既定値）
  "editor.overtypeOnPaste": true,
  // 概要ルーラーに枠線を描画（既定値）
  "editor.overviewRulerBorder": true,
  // エディタ下端と最終行の間の余白（既定値）
  "editor.padding.bottom": 0,
  // エディタ上端と先頭行の間の余白（デフォルト: 0px）先頭行が詰まって見えないように
  "editor.padding.top": 5,
  // 貼り付け方法を選べるようにする（既定値）
  "editor.pasteAs.enabled": true,
  // 貼り付け時に優先する編集種別の順序（既定値）
  "editor.pasteAs.preferences": [],
  // 貼り付け後に挿入方法の選択ウィジェットを表示（既定値）
  "editor.pasteAs.showPasteSelector": "afterPaste",
  // Peekビューを開いた際のフォーカス先（既定値）
  "editor.peekWidgetDefaultFocus": "tree",
  // リネーム前に変更内容をプレビューできるようにする（既定値）
  "editor.rename.enablePreview": true,
  // 制御文字（見えない文字）を可視化（既定値）
  "editor.renderControlCharacters": true,
  // ファイル末尾が改行の場合に最終行番号を表示（既定値）
  "editor.renderFinalNewline": "on",
  // 現在行のハイライト方法（既定値）
  "editor.renderLineHighlight": "line",
  // エディタにフォーカスがある時のみ現在行をハイライト（既定値）
  "editor.renderLineHighlightOnlyWhenFocus": false,
  // スクリーンリーダー向けリッチコンテンツの描画（既定値）editContextが有効な時のみ作用
  "editor.renderRichScreenReaderContent": false,
  // すべての空白文字を常に表示（デフォルト: "selection"=選択時のみ）全角スペース等の混入検知のため
  "editor.renderWhitespace": "all",
  // 選択範囲の角を丸める（既定値）
  "editor.roundedSelection": true,
  // 縦ルーラーを80/100/150桁に表示（デフォルト: []）コード幅の目安として
  "editor.rulers": [80, 100, 150],
  // インライン補完をスクリーンリーダーで読み上げる（既定値）
  "editor.screenReaderAnnounceInlineSuggestion": true,
  // 最終列以降に水平スクロールできる余白（既定値）
  "editor.scrollBeyondLastColumn": 4,
  // 最終行以降に垂直スクロールできるようにする（既定値）
  "editor.scrollBeyondLastLine": true,
  // 中ボタン押下でスクロールモードに入る（既定値）
  "editor.scrollOnMiddleClick": false,
  // 縦横同時スクロール時に主要な軸のみスクロール（既定値）トラックパッドの横滑り防止
  "editor.scrollPredominantAxis": true,
  // 水平スクロールバーの表示（既定値）
  "editor.scrollbar.horizontal": "auto",
  // 水平スクロールバーの高さ（デフォルト: 12px）
  "editor.scrollbar.horizontalScrollbarSize": 10,
  // 水平スクロールバーの分だけコンテンツ高を増やさない（既定値）
  "editor.scrollbar.ignoreHorizontalScrollbarInContentHeight": false,
  // スクロールバークリック時にページ単位でスクロール（既定値）falseはクリック位置へジャンプ
  "editor.scrollbar.scrollByPage": false,
  // 垂直スクロールバーの表示（既定値）
  "editor.scrollbar.vertical": "auto",
  // 垂直スクロールバーの幅（デフォルト: 14px）掴みやすくするため拡大
  "editor.scrollbar.verticalScrollbarSize": 15,
  // 選択文字列と同じ箇所をハイライト（既定値）
  "editor.selectionHighlight": true,
  // 類似箇所ハイライトを行う選択文字数の上限（既定値）0で無制限
  "editor.selectionHighlightMaxLength": 200,
  // 複数行にまたがる選択でも類似箇所をハイライト（既定値）
  "editor.selectionHighlightMultiline": false,
  // セマンティックハイライトの有効化（既定値）テーマの指定に従う
  "editor.semanticHighlighting.enabled": "configuredByTheme",
  // セマンティックトークンの色・スタイルの上書き（既定値）
  "editor.semanticTokenColorCustomizations": {},
  // 折りたたみコントロールの表示タイミング（既定値）
  "editor.showFoldingControls": "mouseover",
  // 未使用コードを淡色表示（既定値）
  "editor.showUnused": true,
  // 選択範囲の拡張で前後の空白を含める（既定値）
  "editor.smartSelect.selectLeadingAndTrailingWhitespace": true,
  // 選択範囲の拡張でサブワード（fooBarのfoo等）を対象にする（既定値）
  "editor.smartSelect.selectSubwords": true,
  // アニメーション付きスクロール（デフォルト: false）スクロール位置を見失わないように
  "editor.smoothScrolling": true,
  // 囲みスニペット・ファイルテンプレートをコードアクションに出す（デフォルト: true）候補が増えすぎるため無効化
  "editor.snippets.codeActions.enabled": false,
  // ダブルクリックやEscでもPeekエディタを開いたままにする（既定値）
  "editor.stablePeek": false,
  // スティッキースクロールで固定する行の判定モデル（既定値）
  "editor.stickyScroll.defaultModel": "outlineModel",
  // スティッキースクロール（上部に親スコープを固定表示）（既定値）
  "editor.stickyScroll.enabled": true,
  // スティッキースクロールの最大表示行数（デフォルト: 5）ネストの深いコードでも追えるように
  "editor.stickyScroll.maxLineCount": 10,
  // スティッキースクロールを水平スクロールに追従させる（既定値）
  "editor.stickyScroll.scrollWithEditor": true,
  // スペースインデントでもタブストップ単位で選択を吸着（既定値）
  "editor.stickyTabStops": false,
  // Tabキーをフォーカス移動に使う（既定値）
  "editor.tabFocusMode": false,
  // タブ幅（デフォルト: 4）2スペース統一
  "editor.tabSize": 2,
  // トークンカラーのカスタマイズ（デフォルト: {}）ライト/ダークテーマでの検索マッチテキスト色
  "editor.tokenColorCustomizations": {
    "[*Light*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#000"
          }
        }
      ]
    },
    "[*Dark*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#fff"
          }
        }
      ]
    }
  },
  // 自動挿入された末尾空白のトリム（デフォルト: true）意図しない差分を避けるため無効化
  "editor.trimAutoWhitespace": false,
  // 改行削除時に次行のインデント空白も削除（既定値）
  "editor.trimWhitespaceOnDelete": false,
  // 折りたたまれた行の行末より後ろをクリックして展開（既定値）
  "editor.unfoldOnClickAfterEndOfLine": false,
  // Unicode強調表示から除外する文字（既定値）
  "editor.unicodeHighlight.allowedCharacters": {},
  // Unicode強調表示から除外するロケール（既定値）
  "editor.unicodeHighlight.allowedLocales": {
    "_os": true,
    "_vscode": true
  },
  // ASCIIと紛らわしい文字を強調（既定値）
  "editor.unicodeHighlight.ambiguousCharacters": true,
  // コメント内もUnicode強調の対象にする（既定値）
  "editor.unicodeHighlight.includeComments": "inUntrustedWorkspace",
  // 文字列内もUnicode強調の対象にする（既定値）
  "editor.unicodeHighlight.includeStrings": true,
  // 幅を持たない不可視文字を強調（既定値）
  "editor.unicodeHighlight.invisibleCharacters": true,
  // 非ASCII文字をすべて強調（既定値）
  "editor.unicodeHighlight.nonBasicASCII": "inUntrustedWorkspace",
  // 特殊な改行文字の除去を確認する（既定値）
  "editor.unusualLineTerminators": "prompt",
  // タブストップに合わせてスペースを挿入・削除（既定値）
  "editor.useTabStops": true,
  // 日本語・中国語・韓国語（CJK）の改行規則（既定値）
  "editor.wordBreak": "normal",
  // 単語分割に使うロケール（デフォルト: []）日本語の単語境界を正しく認識させる
  "editor.wordSegmenterLocales": ["ja"],
  // 単語区切りとして扱う文字（既定値）
  "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?",
  // 行の折り返し（既定値）
  "editor.wordWrap": "off",
  // 折り返す桁数（デフォルト: 80）wordWrapが"wordWrapColumn"/"bounded"の時に作用
  "editor.wordWrapColumn": 100,
  // 文字列中の \n で折り返す（既定値）
  "editor.wrapOnEscapedLineFeeds": false,
  // 折り返し行のインデント（既定値）
  "editor.wrappingIndent": "same",
  // 折り返し位置の計算アルゴリズム（既定値）
  "editor.wrappingStrategy": "simple",

  // =============================================
  // Text Editor > Cursor - カーソル
  // =============================================

  // カーソルの点滅スタイル（デフォルト: "blink"）滑らかなアニメーションにする
  "editor.cursorBlinking": "smooth",
  // カーソルの高さ（既定値）cursorStyleが"line"の時に作用。0で行高に合わせる
  "editor.cursorHeight": 0,
  // カーソル移動時のスムーズアニメーション（既定値）
  "editor.cursorSmoothCaretAnimation": "off",
  // 挿入モード時のカーソル形状（既定値）
  "editor.cursorStyle": "line",
  // カーソル周辺に確保する表示行数（デフォルト: 0）スクロール位置を安定させるため
  "editor.cursorSurroundingLines": 20,
  // cursorSurroundingLinesを適用する条件（既定値）
  "editor.cursorSurroundingLinesStyle": "default",
  // カーソルの幅（デフォルト: 0=自動）視認性のため2pxに固定
  "editor.cursorWidth": 2,

  // =============================================
  // Text Editor > Find - 検索
  // =============================================

  // 検索ウィジェット表示時にエディタ上部へ余白を追加（既定値）
  "editor.find.addExtraSpaceOnTop": true,
  // 選択範囲内検索を自動で有効にする条件（既定値）
  "editor.find.autoFindInSelection": "never",
  // 検索結果に到達したら検索ウィジェットを閉じる（既定値）
  "editor.find.closeOnResult": false,
  // 入力中にカーソルを一致箇所へ移動（既定値）
  "editor.find.cursorMoveOnType": true,
  // 入力しながら逐次検索（既定値）
  "editor.find.findOnType": true,
  // macOSの共有検索クリップボードを使用（デフォルト: false）他アプリと検索文字列を共有するため
  "editor.find.globalFindClipboard": true,
  // 検索履歴の保存単位（既定値）
  "editor.find.history": "workspace",
  // 末尾まで到達したら先頭から検索し直す（既定値）
  "editor.find.loop": true,
  // 置換履歴の保存単位（既定値）
  "editor.find.replaceHistory": "workspace",
  // 選択中のテキストを検索文字列の初期値にする（既定値）
  "editor.find.seedSearchStringFromSelection": "always",

  // =============================================
  // Text Editor > Font - フォント
  // =============================================

  // フォントファミリー（デフォルト: "Menlo, Monaco, 'Courier New', monospace"）
  // Fira Codeを優先。init-mac.zshがHomebrewでインストールする
  "editor.fontFamily": "'Fira Code', Menlo, Monaco, 'Courier New', monospace",
  // フォント合字を有効化（デフォルト: false）=> → ≠ などの合字表示
  "editor.fontLigatures": true,
  // フォントサイズ（デフォルト: 12px）
  "editor.fontSize": 11.5,
  // バリアブルフォントの font-variation-settings（既定値）
  "editor.fontVariations": false,
  // フォントの太さ（既定値）
  "editor.fontWeight": "normal",
  // 文字間隔（既定値）
  "editor.letterSpacing": 0,
  // 行の高さ（既定値）0はフォントサイズから自動計算
  "editor.lineHeight": 0,

  // =============================================
  // Text Editor > Formatting - 書式設定
  // =============================================

  // ペースト時に自動フォーマット（デフォルト: false）
  "editor.formatOnPaste": true,
  // 保存時に自動フォーマット（デフォルト: false）
  "editor.formatOnSave": true,
  // 保存時フォーマットの対象範囲（既定値）ファイル全体をフォーマットする
  "editor.formatOnSaveMode": "file",
  // 入力時に自動フォーマット（デフォルト: false）
  "editor.formatOnType": true,

  // =============================================
  // Text Editor > Diff Editor - 差分エディタ
  // =============================================

  // 差分エディタでCodeLensを表示（デフォルト: false）
  "diffEditor.codeLens": true,
  // 差分計算アルゴリズム（既定値）
  "diffEditor.diffAlgorithm": "advanced",
  // 挿入・削除位置を示す空の装飾を表示（実験的機能・既定値）
  "diffEditor.experimental.showEmptyDecorations": true,
  // 検出したコードの移動を表示（実験的機能・既定値）
  "diffEditor.experimental.showMoves": false,
  // インライン表示時に単語単位の変更をインライン描画（実験的機能・既定値）
  "diffEditor.experimental.useTrueInlineView": false,
  // 変更なし領域を折りたたむ際に残す前後の行数（既定値）
  "diffEditor.hideUnchangedRegions.contextLineCount": 3,
  // 変更のない領域を折りたたんで非表示にする（デフォルト: false）差分に集中するため
  "diffEditor.hideUnchangedRegions.enabled": true,
  // 折りたたむ最小行数（デフォルト: 3）細切れの折りたたみを避けるため
  "diffEditor.hideUnchangedRegions.minimumLineCount": 10,
  // 折りたたみを展開する際に一度に表示する行数（既定値）
  "diffEditor.hideUnchangedRegions.revealLineCount": 20,
  // 前後の空白のみの差分を無視する（デフォルト: true）空白の変更も検知したいため無効化
  "diffEditor.ignoreTrimWhitespace": false,
  // 差分計算のタイムアウト（既定値）0で無制限
  "diffEditor.maxComputationTime": 5000,
  // 差分を計算する最大ファイルサイズ（デフォルト: 50MB）大きめのファイルも比較できるように
  "diffEditor.maxFileSize": 100,
  // 取り消し・ステージ操作用のガター（余白領域）を表示（既定値）
  "diffEditor.renderGutterMenu": true,
  // 追加・削除の +/- インジケーターを表示（既定値）
  "diffEditor.renderIndicators": true,
  // グリフマージンに変更を戻す矢印を表示（既定値）
  "diffEditor.renderMarginRevertIcon": true,
  // 差分をサイドバイサイドで表示（既定値）
  "diffEditor.renderSideBySide": true,
  // サイドバイサイドからインライン表示に切り替える幅（デフォルト: 900px）
  "diffEditor.renderSideBySideInlineBreakpoint": 1000,
  // 幅が狭い場合にインライン表示へ切り替える（既定値）
  "diffEditor.useInlineViewWhenSpaceIsLimited": true,
  // 差分エディタの折り返し（既定値）エディタ本体の設定を継承する
  "diffEditor.wordWrap": "inherit",

  // =============================================
  // Text Editor > Minimap - ミニマップ（右側のファイル全体プレビュー）
  // =============================================

  // ミニマップの自動非表示（既定値）
  "editor.minimap.autohide": "none",
  // ミニマップを表示（既定値）
  "editor.minimap.enabled": true,
  // セクションヘッダーとして扱うコメントの正規表現（既定値）
  "editor.minimap.markSectionHeaderRegex": "\\bMARK:\\s*(?<separator>-?)\\s*(?<label>.*)$",
  // ミニマップの最大列数（デフォルト: 120）横幅を取りすぎないよう制限
  "editor.minimap.maxColumn": 80,
  // 色ブロックではなく実際の文字を描画（既定値）
  "editor.minimap.renderCharacters": true,
  // ミニマップの描画倍率（既定値）
  "editor.minimap.scale": 1,
  // セクションヘッダーのフォントサイズ（既定値）
  "editor.minimap.sectionHeaderFontSize": 9,
  // セクションヘッダーの文字間隔（デフォルト: 1）小さい文字でも読めるように広げる
  "editor.minimap.sectionHeaderLetterSpacing": 2,
  // MARK: コメントをセクションヘッダーとして表示（既定値）
  "editor.minimap.showMarkSectionHeaders": true,
  // #region をセクションヘッダーとして表示（既定値）
  "editor.minimap.showRegionSectionHeaders": true,
  // ミニマップのスライダーを常に表示（デフォルト: "mouseover"）現在位置を常に把握するため
  "editor.minimap.showSlider": "always",
  // ミニマップを表示する側（既定値）
  "editor.minimap.side": "right",
  // ミニマップのサイズ調整方法（既定値）
  "editor.minimap.size": "proportional",

  // =============================================
  // Text Editor > Suggestions - 補完候補
  // =============================================

  // コミット文字（JSの`;`など）で補完を確定（既定値）
  "editor.acceptSuggestionOnCommitCharacter": true,
  // Enterキーでも補完を確定（既定値）
  "editor.acceptSuggestionOnEnter": "on",
  // インライン補完時にスクリーンリーダー向けヒントを出す（既定値）
  "editor.inlineCompletionsAccessibilityVerbose": false,
  // インライン補完の表示時にコードをずらして領域を確保（既定値）
  "editor.inlineSuggest.edits.allowCodeShifting": "always",
  // 離れた位置のインライン補完プレビューで前後に表示する行数（既定値）0で対象行のみ
  "editor.inlineSuggest.edits.longDistanceHintContextLineCount": 0,
  // 大きなインライン補完をサイドバイサイド表示（既定値）
  "editor.inlineSuggest.edits.renderSideBySide": "auto",
  // ジャンプするまでインライン補完を折りたたんで表示（既定値）
  "editor.inlineSuggest.edits.showCollapsed": false,
  // 離れた位置へのインライン補完を表示（既定値）
  "editor.inlineSuggest.edits.showLongDistanceHint": true,
  // インライン補完（ゴーストテキスト）を自動表示（既定値）
  "editor.inlineSuggest.enabled": true,
  // インライン補完プロバイダーへリクエスト情報を送信（実験的機能・既定値）
  "editor.inlineSuggest.experimental.emptyResponseInformation": true,
  // 補完ウィジェットと競合する場合もインライン補完を表示（実験的機能・既定値）
  "editor.inlineSuggest.experimental.showOnSuggestConflict": "never",
  // インライン補完を抑制する拡張機能ID（実験的機能・既定値）カンマ区切り
  "editor.inlineSuggest.experimental.suppressInlineSuggestions": "",
  // インライン補完のフォントファミリー（既定値）
  "editor.inlineSuggest.fontFamily": "default",
  // 入力後にインライン補完を表示するまでの最小遅延（既定値）
  "editor.inlineSuggest.minShowDelay": 0,
  // インライン補完のツールバーを表示するタイミング（既定値）
  "editor.inlineSuggest.showToolbar": "onHover",
  // スニペット編集中はインライン補完を抑制（既定値）
  "editor.inlineSuggest.suppressInSnippetMode": true,
  // インライン補完がある時は補完ウィジェットを自動表示しない（既定値）
  "editor.inlineSuggest.suppressSuggestions": false,
  // インライン補完にシンタックスハイライトを適用（既定値）
  "editor.inlineSuggest.syntaxHighlightingEnabled": true,
  // インライン補完プロバイダーの切り替え時にコマンドを実行（既定値）
  "editor.inlineSuggest.triggerCommandOnProviderChange": false,
  // パラメータヒントを末尾で先頭に戻す循環表示にする（既定値）
  "editor.parameterHints.cycle": true,
  // 入力中に引数の説明・型情報をポップアップ表示（既定値）
  "editor.parameterHints.enabled": true,
  // 入力中に補完候補を自動表示する範囲（既定値）コメント・文字列内では出さない
  "editor.quickSuggestions": {
    "other": "offWhenInlineCompletions",
    "comments": "off",
    "strings": "off"
  },
  // 補完候補の自動表示までの遅延（既定値）
  "editor.quickSuggestionsDelay": 10,
  // スニペットを他の候補と一緒に表示する方法（既定値）
  "editor.snippetSuggestions": "inline",
  // 軽微なタイプミスを許容して候補を絞り込む（既定値）
  "editor.suggest.filterGraceful": true,
  // 補完確定時に後続の単語を上書きするか（既定値）"insert"は上書きしない
  "editor.suggest.insertMode": "insert",
  // カーソル近くに現れる単語を優先して並べる（既定値）
  "editor.suggest.localityBonus": false,
  // 先頭文字が単語の先頭に一致する候補のみ表示（既定値）
  "editor.suggest.matchOnWordStartOnly": true,
  // 補完結果をエディタ内にプレビュー表示（既定値）
  "editor.suggest.preview": false,
  // 補完ウィジェット表示時に候補を選択状態にする（既定値）
  "editor.suggest.selectionMode": "always",
  // 補完候補の選択履歴を複数ワークスペース間で共有（既定値）
  "editor.suggest.shareSuggestSelections": false,
  // クラスの候補を表示（既定値）
  "editor.suggest.showClasses": true,
  // 色の候補を表示（既定値）
  "editor.suggest.showColors": true,
  // 定数の候補を表示（既定値）
  "editor.suggest.showConstants": true,
  // コンストラクタの候補を表示（既定値）
  "editor.suggest.showConstructors": true,
  // カスタムカラーの候補を表示（既定値）
  "editor.suggest.showCustomcolors": true,
  // 列挙型メンバーの候補を表示（既定値）
  "editor.suggest.showEnumMembers": true,
  // 列挙型の候補を表示（既定値）
  "editor.suggest.showEnums": true,
  // イベントの候補を表示（既定値）
  "editor.suggest.showEvents": true,
  // フィールドの候補を表示（既定値）
  "editor.suggest.showFields": true,
  // ファイルの候補を表示（既定値）
  "editor.suggest.showFiles": true,
  // フォルダの候補を表示（既定値）
  "editor.suggest.showFolders": true,
  // 関数の候補を表示（既定値）
  "editor.suggest.showFunctions": true,
  // 補完候補にアイコンを表示（既定値）
  "editor.suggest.showIcons": true,
  // 候補の詳細をラベル横にインライン表示（既定値）
  "editor.suggest.showInlineDetails": true,
  // インターフェースの候補を表示（既定値）
  "editor.suggest.showInterfaces": true,
  // 課題（issue）の候補を表示（既定値）
  "editor.suggest.showIssues": true,
  // キーワードの候補を表示（既定値）
  "editor.suggest.showKeywords": true,
  // メソッドの候補を表示（既定値）
  "editor.suggest.showMethods": true,
  // モジュールの候補を表示（既定値）
  "editor.suggest.showModules": true,
  // 演算子の候補を表示（既定値）
  "editor.suggest.showOperators": true,
  // プロパティの候補を表示（既定値）
  "editor.suggest.showProperties": true,
  // 参照の候補を表示（既定値）
  "editor.suggest.showReferences": true,
  // スニペットの候補を表示（既定値）
  "editor.suggest.showSnippets": true,
  // 補完ウィジェット下部のステータスバーを表示（既定値）
  "editor.suggest.showStatusBar": false,
  // 構造体の候補を表示（既定値）
  "editor.suggest.showStructs": true,
  // 型パラメータの候補を表示（既定値）
  "editor.suggest.showTypeParameters": true,
  // 単位の候補を表示（既定値）
  "editor.suggest.showUnits": true,
  // ユーザーの候補を表示（既定値）
  "editor.suggest.showUsers": true,
  // 値の候補を表示（既定値）
  "editor.suggest.showValues": true,
  // 変数の候補を表示（既定値）
  "editor.suggest.showVariables": true,
  // ドキュメント内の単語（テキスト）候補を表示（既定値）
  "editor.suggest.showWords": true,
  // スニペット編集中に補完候補の自動表示を抑制（既定値）
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  // 補完ウィジェットのフォントサイズ（既定値）0はeditor.fontSizeを使う
  "editor.suggestFontSize": 0,
