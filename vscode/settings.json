  // 検索結果を展開した状態にする（既定値）
  "search.collapseResults": "alwaysExpand",
  // 検索結果のファイル装飾にバッジを使う（既定値）
  "search.decorations.badges": true,
  // 検索結果のファイル装飾に色を使う（既定値）
  "search.decorations.colors": true,
  // 検索結果の既定の表示形式（既定値）
  "search.defaultViewMode": "list",
  // 全文検索・クイックオープンから除外するパス（既定値）
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true
  },
  // 閉じているノートブックのリッチコンテンツも検索結果に出す（実験的機能・既定値）
  "search.experimental.closedNotebookRichContentResults": false,
