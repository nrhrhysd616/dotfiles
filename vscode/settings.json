  // ソース管理ビューにアクションボタンを表示（既定値）
  "scm.showActionButton": true,
  // ソース管理の入力欄にアクションボタンを表示（既定値）
  "scm.showInputActionButton": true,
  // 履歴アイテムグループ切り替え時の既定のワーキングセット（既定値）
  "scm.workingSets.default": "current",
  // 履歴アイテムグループ切り替え時にエディタのワーキングセットを保存する（既定値）
  "scm.workingSets.enabled": false,

  // --- 外部ターミナル ---

  // エクスプローラーからターミナルで開く際の種類（デフォルト: "integrated"）iTermを使うため外部に
  "terminal.explorerKind": "external",
  // Linuxで使う外部ターミナル（既定値）
  "terminal.external.linuxExec": "xterm",
  // macOSで使う外部ターミナル（デフォルト: "Terminal.app"）iTerm2を使用
  "terminal.external.osxExec": "iTerm.app",
  // Windowsで使う外部ターミナル（既定値）
  "terminal.external.windowsExec": "C:\\Windows\\System32\\cmd.exe",
  // ソース管理ビューからターミナルで開く際の種類（既定値）
  "terminal.sourceControlRepositoriesKind": "integrated",

  // --- 統合ターミナル: 表示・フォント ---

  // ターミナルのフォントファミリー（既定値）空はeditor.fontFamilyを継承
  "terminal.integrated.fontFamily": "",
  // ターミナルで合字を有効化（既定値）
  "terminal.integrated.fontLigatures.enabled": false,
  // フォントが解析できない場合に使う合字の代替リスト（既定値）
  "terminal.integrated.fontLigatures.fallbackLigatures": [
    "<--",
    "<---",
    "<<-",
    "<-",
    "->",
    "->>",
    "-->",
    "--->",
    "<==",
    "<===",
    "<<=",
    "<=",
    "=>",
    "=>>",
    "==>",
    "===>",
    ">=",
    ">>=",
    "<->",
    "<-->",
    "<--->",
