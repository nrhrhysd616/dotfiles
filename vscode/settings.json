    "<=>",
    "<==>",
    "<===>",
    "<====>",
    "::",
    ":::",
    "<~~",
    "</",
    "</>",
    "/>",
    "~~>",
    "==",
    "!=",
    "/=",
    "~=",
    "<>",
    "===",
    "!==",
    "!===",
    "<:",
    ":=",
    "*=",
    "*+",
    "<*",
    "<*>",
    "*>",
    "<|",
    "<|>",
    "|>",
    "+*",
    "=*",
    "=:",
    ":>",
    "/*",
    "*/",
    "+++",
    "<!--",
    "<!---"
  ],
  // 合字有効時のfont-feature-settings（既定値）
  "terminal.integrated.fontLigatures.featureSettings": "\"calt\" on",
  // ターミナルのフォントサイズ（既定値）
  "terminal.integrated.fontSize": 12,
  // 通常テキストのフォントの太さ（既定値）
  "terminal.integrated.fontWeight": "normal",
  // 太字テキストのフォントの太さ（既定値）
  "terminal.integrated.fontWeightBold": "bold",
  // 文字間隔（既定値・追加ピクセル数）
  "terminal.integrated.letterSpacing": 0,
  // 行の高さ（既定値）フォントサイズに対する倍率
  "terminal.integrated.lineHeight": 1,
  // カーソルを点滅させる（既定値）
  "terminal.integrated.cursorBlinking": false,
  // フォーカス時のカーソル形状（デフォルト: "block"）エディタと揃えて線カーソルにする
  "terminal.integrated.cursorStyle": "line",
  // 非フォーカス時のカーソル形状（既定値）
  "terminal.integrated.cursorStyleInactive": "outline",
  // cursorStyleが"line"の時のカーソル幅（既定値）
  "terminal.integrated.cursorWidth": 1,
  // 罫線などをフォントではなく独自グリフで描画（既定値）gpuAccelerationが有効な時のみ作用
  "terminal.integrated.customGlyphs": true,
  // 太字を明るいANSI色で描画する（既定値）
  "terminal.integrated.drawBoldTextInBrightColors": true,
  // GPUによる描画を使う（既定値）
  "terminal.integrated.gpuAcceleration": "auto",
  // 前景色を調整して確保する最小コントラスト比（既定値）
  "terminal.integrated.minimumContrastRatio": 4.5,
  // 隣のセルにはみ出すグリフを横方向に縮小する（既定値）
  "terminal.integrated.rescaleOverlappingGlyphs": true,
  // リサイズ時に桁数・行数のオーバーレイを表示（既定値）
  "terminal.integrated.resizeDimensionsOverlay.enabled": true,
  // アニメーション付きスクロール（既定値）
  "terminal.integrated.smoothScrolling": false,
  // 文字の点滅表示を有効化（既定値）
  "terminal.integrated.textBlinking": false,
  // 文字幅計算に使うUnicodeのバージョン（既定値）
  "terminal.integrated.unicodeVersion": "11",
  // タブストップの桁数（既定値）
  "terminal.integrated.tabStopWidth": 8,
  // 画像表示を有効化（既定値）gpuAccelerationが有効な時のみ作用
  "terminal.integrated.enableImages": false,

  // --- 統合ターミナル: 動作 ---

  // 未信頼のワークスペースでターミナルを作成できるようにする（既定値）
  // 起動時にコードが実行され得るためセキュリティ上の保護。無効のまま
  "terminal.integrated.allowInUntrustedWorkspace": false,
  // ターミナル内でコード（連続キー）バインドを許可（既定値）
  "terminal.integrated.allowChords": true,
  // Alt+Fなどでメニューバーを開けるようにする（既定値）macOSでは無効
  "terminal.integrated.allowMnemonics": false,
  // ターミナルからリンクを開ける URIスキーム（既定値）
  "terminal.integrated.allowedLinkSchemes": [
    "file",
    "http",
    "https",
    "mailto",
    "vscode",
    "vscode-insiders"
  ],
  // Option+クリックでカーソルを移動する（既定値）
  "terminal.integrated.altClickMovesCursor": true,
  // 特定のメッセージに自動応答する設定（既定値）
  "terminal.integrated.autoReplies": {},
  // ベル表示の継続時間（既定値・ミリ秒）
  "terminal.integrated.bellDuration": 1000,
  // シェルへ送らずVSCodeが処理するコマンドID（既定値）
  "terminal.integrated.commandsToSkipShell": [],
  // ターミナル実行中にウィンドウを閉じる際に確認する（既定値）
  "terminal.integrated.confirmOnExit": "never",
  // 子プロセスがあるターミナルを終了する際に確認する（既定値）
  "terminal.integrated.confirmOnKill": "editor",
  // 選択したテキストを自動的にクリップボードへコピー（既定値）
  "terminal.integrated.copyOnSelection": false,
  // ターミナルの起動ディレクトリ（既定値）空はワークスペースルート
  "terminal.integrated.cwd": "",
  // 新規ターミナルを作成する場所（既定値）
  "terminal.integrated.defaultLocation": "view",
  // Linuxの既定プロファイル（既定値）
  "terminal.integrated.defaultProfile.linux": null,
  // macOSの既定プロファイル（既定値）nullは$SHELLを使う
  "terminal.integrated.defaultProfile.osx": null,
  // Windowsの既定プロファイル（既定値）
  "terminal.integrated.defaultProfile.windows": null,
  // $LANG をUTF-8対応の値に自動設定する（既定値）
  "terminal.integrated.detectLocale": "auto",
  // ファイルリンクを有効化（既定値）ネットワークドライブでは遅くなることがある
  "terminal.integrated.enableFileLinks": "on",
  // kittyキーボードプロトコルを有効化（既定値）Shift+Enterなどを詳細に扱える
  "terminal.integrated.enableKittyKeyboardProtocol": true,
  // 複数行を貼り付ける際に警告を出す（既定値）
  "terminal.integrated.enableMultiLinePasteWarning": "auto",
  // OSC 99による通知を表示（既定値）
  "terminal.integrated.enableNotifications": true,
  // ウィンドウ再読み込み後もターミナルのセッション・履歴を保持（既定値）
  "terminal.integrated.enablePersistentSessions": true,
  // ビジュアルベル（視覚的なベル通知）を有効化（既定値）
  "terminal.integrated.enableVisualBell": false,
  // Windowsの拡張キーボード入力モードを有効化（既定値）
  "terminal.integrated.enableWin32InputMode": false,
  // Linuxのターミナルに追加する環境変数（既定値）
  "terminal.integrated.env.linux": {},
  // macOSのターミナルに追加する環境変数（既定値）
  "terminal.integrated.env.osx": {},
  // Windowsのターミナルに追加する環境変数（既定値）
  "terminal.integrated.env.windows": {},
  // 拡張機能が環境変数を変更した際にターミナルを自動再起動する（既定値）
  "terminal.integrated.environmentChangesRelaunch": true,
  // Alt+スクロール時の高速スクロール倍率（既定値）
  "terminal.integrated.fastScrollSensitivity": 5,
  // 「選択範囲をターミナルで実行」後のフォーカス先（既定値）
  "terminal.integrated.focusAfterRun": "none",
  // 最後のターミナルを閉じた際にターミナルビューを隠す（既定値）
  "terminal.integrated.hideOnLastClosed": true,
  // 起動時にターミナルビューを隠す（既定値）
  "terminal.integrated.hideOnStartup": "never",
  // ブラケットペーストモードを無視する（既定値）
  "terminal.integrated.ignoreBracketedPasteMode": false,
  // confirmOnKillで無視するプロセス名（既定値）
  "terminal.integrated.ignoreProcessNames": ["starship", "oh-my-posh", "bash", "zsh"],
  // 新規シェルがVSCodeの環境を引き継ぐ（既定値）$PATH等の初期化のためログインシェルを経由する
  "terminal.integrated.inheritEnv": true,
  // 最初のターミナルに操作ヒントを表示（既定値）
  "terminal.integrated.initialHint": true,
  // ローカルエコーを有効にする条件（既定値）
  "terminal.integrated.localEchoEnabled": "off",
  // ローカルエコーを無効にするプログラム名（既定値）
  "terminal.integrated.localEchoExcludePrograms": ["vim", "vi", "nano", "tmux"],
  // ローカルエコーを行うネットワーク遅延のしきい値（既定値・ミリ秒）
  "terminal.integrated.localEchoLatencyThreshold": 30,
  // ローカルエコーされた文字のスタイル（既定値）
  "terminal.integrated.localEchoStyle": "dim",
  // macOSでOption+クリック時に矩形選択ではなく通常選択を強制する（既定値）
  "terminal.integrated.macOptionClickForcesSelection": false,
  // macOSでOptionキーをMetaキーとして扱う（既定値）
  "terminal.integrated.macOptionIsMeta": false,
  // 中クリック時の動作（既定値）
  "terminal.integrated.middleClickBehavior": "default",
  // マウスホイールのスクロール量倍率（既定値）
  "terminal.integrated.mouseWheelScrollSensitivity": 1,
  // Cmd+ホイールでフォントサイズを変更（既定値）
  "terminal.integrated.mouseWheelZoom": false,
  // 永続セッションのプロセスを復元するタイミング（既定値）
  "terminal.integrated.persistentSessionReviveProcess": "onExit",
  // 永続セッション復元時に戻すスクロールバックの行数（既定値）反映には再起動が必要
  "terminal.integrated.persistentSessionScrollback": 100,
  // 右クリック時の動作（既定値）
  "terminal.integrated.rightClickBehavior": "selectWord",
  // スクロールバックの最大行数（既定値）増やすとメモリ使用量も増える
  "terminal.integrated.scrollback": 1000,
  // ほとんどのキーバインドをシェルへ送る（既定値）
  "terminal.integrated.sendKeybindingsToShell": false,
  // 「終了コード」の警告を表示（既定値）
  "terminal.integrated.showExitAlert": true,
  // リンクのホバーを表示（既定値）
  "terminal.integrated.showLinkHover": true,
  // 分割したターミナルの作業ディレクトリ（既定値）
  "terminal.integrated.splitCwd": "inherited",
  // WSLディストリビューションをターミナル一覧に表示（既定値）
  "terminal.integrated.useWslProfiles": true,
  // VSCode同梱の conpty.dll を使う（既定値）Windowsのみ
  "terminal.integrated.windowsUseConptyDll": true,
  // ダブルクリックの単語選択で区切りとみなす文字（既定値）
  "terminal.integrated.wordSeparators": " ()[]{}',\"`─‘’“”|",

  // --- 統合ターミナル: プロファイル ---

