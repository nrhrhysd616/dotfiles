  // タブビューを隠す条件（既定値）
  "terminal.integrated.tabs.hideCondition": "singleTerminal",
  // タブビューの表示位置（既定値）
  "terminal.integrated.tabs.location": "right",
  // タイトル・説明で使う区切り文字（既定値）
  "terminal.integrated.tabs.separator": " - ",
  // 分割・終了ボタンを表示する条件（既定値）
  "terminal.integrated.tabs.showActions": "singleTerminalOrNarrow",
  // アクティブなターミナル情報を表示する条件（既定値）
  "terminal.integrated.tabs.showActiveTerminal": "singleTerminalOrNarrow",
  // ターミナルタイトルの書式（既定値）
  "terminal.integrated.tabs.title": "${process}",

  // --- 統合ターミナル: アクセシビリティ・開発者向け ---

  // コマンド実行時にアクセシブルビューへフォーカスする（既定値）
  "terminal.integrated.accessibleViewFocusOnCommandExecution": false,
  // アクセシブルビューでカーソル位置を保持する（既定値）
  "terminal.integrated.accessibleViewPreserveCursorPosition": false,
  // ターミナルの開発者モード（既定値）シェル統合シーケンスのデバッグ情報を表示
  "terminal.integrated.developer.devMode": false,
  // ptyホストへの呼び出しに加える擬似遅延（既定値）テスト用
  "terminal.integrated.developer.ptyHost.latency": 0,
  // ptyホストの擬似起動遅延（既定値）テスト用
  "terminal.integrated.developer.ptyHost.startupDelay": 0,

  // =============================================
  // Features > Task - タスク
  // =============================================

  // 自動タスクを有効化（既定値）信頼されていないワークスペースでは実行されない
  "task.allowAutomaticTasks": "off",
  // タスクプロバイダーによるタスクの自動検出（既定値）遅い場合は無効化すると改善する
  "task.autoDetect": "on",
  // 非フォーカス時にOS通知を出すタスクの最小実行時間（既定値）-1で通知無効
  "task.notifyWindowOnTaskCompletion": 60000,
  // タスク実行時に問題マッチャーの選択を確認しない（既定値）
  "task.problemMatchers.neverPrompt": false,
  // タスクのクイックピックに詳細を表示（既定値）
  "task.quickOpen.detail": true,
  // タスクのクイックオープンで保持する履歴数（既定値）
