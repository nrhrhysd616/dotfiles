  // =============================================
  // Window - ウィンドウ
  // =============================================

  // OSのカラーモードに応じてテーマを自動切り替え（既定値）
  "window.autoDetectColorScheme": false,
  // OSがハイコントラストの時にテーマを自動切り替え（既定値）
  "window.autoDetectHighContrast": true,
  // 非アクティブウィンドウのクリックで直下の要素も同時に押せる（既定値）
